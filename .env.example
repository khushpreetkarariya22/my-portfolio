NODE_ENV=development
PORT=3000
# Required for real project, skills, services, contact and admin data.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/khushpreet_portfolio?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=your-private-email@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_12_CHARACTERS_MIN
# Optional: permanent admin image uploads for production (Render disk is ephemeral).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional explicit public URL for sitemap and canonical tags, without trailing slash.
PUBLIC_BASE_URL=
